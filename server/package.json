{
  "name": "pb-expelatnas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API untuk website PB EX PELATNAS (Express + Prisma + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\""
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@vercel/blob": "^2.9.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.10.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
