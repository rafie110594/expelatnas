# ============================================
# PB EX PELATNAS — Backend Environment
# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit .env ke repository.
# ============================================

# Mode aplikasi: development | production | test
NODE_ENV=development

# Port HTTP backend
PORT=4000

# Koneksi PostgreSQL
# Development lokal: postgres:postgres@localhost:5432
DATABASE_URL="postgresql://postgres:POSTGRES_PASSWORD_ANDA@localhost:5432/pb_expelatnas?schema=public"

# Origin frontend yang diizinkan CORS (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:4173

# Secret JWT — WAJIB diganti di production (generate: openssl rand -hex 48)
JWT_ACCESS_SECRET=isi-dengan-secret-acak-minimal-48-karakter
JWT_REFRESH_SECRET=isi-dengan-secret-acak-lain-minimal-48-karakter

# Masa berlaku token
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Data seed (hanya dipakai saat npm run db:seed)
SEED_ADMIN_EMAIL=admin@pbexpelatnas.id
SEED_ADMIN_PASSWORD=Admin12345!
SEED_ADMIN_NAME=Head Official
SEED_MEMBER_EMAIL=anthony@pbexpelatnas.id
SEED_MEMBER_PASSWORD=Member12345!
SEED_MEMBER_NAME=Anthony Ginting

# ---------------------------------------------
# Penyimpanan gambar (galeri & event)
# ---------------------------------------------
# local    = simpan file di UPLOAD_DIR, disajikan lewat /uploads
# cloudinary = butuh CLOUDINARY_URL (cloudinary://key:secret@cloud_name)
# vercel-blob = butuh BLOB_READ_WRITE_TOKEN (otomatis saat storage Vercel terhubung)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
# URL asal server untuk membangun URL gambar absolut
PUBLIC_BASE_URL=http://localhost:4000
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
